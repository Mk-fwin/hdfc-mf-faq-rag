# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
#   cp .env.example .env
#
# Without a key the assistant still answers, using a deterministic fallback
# built from the retrieved chunk. See README for the difference.

# Required for live LLM answers. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional. Any chat model on Groq works. This is the same model load_model()
# falls back to when neither the environment nor .env sets one, so leaving it
# out changes nothing.
GROQ_MODEL=openai/gpt-oss-20b
